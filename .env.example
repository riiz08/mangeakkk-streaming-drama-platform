NEXT_PUBLIC_APP_NAME="Mangeakkk"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase PostgreSQL Database Configuration
# Connect to Supabase via connection pooling with Supavisor (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to Supabase database (Port 5432) for migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="mangeakkk"
# Public URL for the bucket (e.g. https://pub-xxxx.r2.dev or https://assets.yourdomain.com)
R2_PUBLIC_URL="https://pub-your-bucket.r2.dev"

# Cloudflare Worker Signed URL Configuration (HMAC SHA256)
VIDEO_SECRET="your_hmac_secret_here"
VIDEO_WORKER_BASE_URL="https://hls-worker.riskimhmmd0.workers.dev"

